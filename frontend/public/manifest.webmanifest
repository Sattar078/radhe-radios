{
  "$schema": "https://json.schemastore.org/web-manifest-combined.json",
  "name": "Radhe Radios Kota — Custom Power Amplifiers & Vehicle Audio",
  "short_name": "Radhe Radios",
  "description": "High-performance Made in India Class-A power amplifiers, custom vehicle audio setups, and dual 18-inch DJ bass cabinets handcrafted in Transport Nagar, Kota, Rajasthan.",
  "start_url": "/?source=pwa",
  "scope": "/",
  "id": "/?source=pwa",
  "display": "standalone",
  "display_override": ["window-controls-overlay", "standalone", "minimal-ui"],
  "background_color": "#000000",
  "theme_color": "#000000",
  "orientation": "portrait-primary",
  "lang": "en-IN",
  "dir": "ltr",
  "categories": ["entertainment", "music", "shopping", "utilities", "business"],
  "icons": [
    {
      "src": "/icons/icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/icons/icon-192-maskable.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "maskable"
    },
    {
      "src": "/icons/icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/icons/icon-512-maskable.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    },
    {
      "src": "/logo.svg",
      "sizes": "any",
      "type": "image/svg+xml",
      "purpose": "any"
    }
  ],
  "shortcuts": [
    {
      "name": "Amps & Sound Rigs",
      "short_name": "Products",
      "description": "Browse custom power amplifiers and vehicle sound systems",
      "url": "/#/products",
      "icons": [
        {
          "src": "/icons/icon-192.png",
          "sizes": "192x192"
        }
      ]
    },
    {
      "name": "About Workshop",
      "short_name": "About Us",
      "description": "Learn about our Kota engineering heritage and Made in India amplifiers",
      "url": "/#/about",
      "icons": [
        {
          "src": "/icons/icon-192.png",
          "sizes": "192x192"
        }
      ]
    },
    {
      "name": "Workshop Dealership Desk",
      "short_name": "Dealership",
      "description": "Direct inquiry desk in Transport Nagar, Kota",
      "url": "/#/contact",
      "icons": [
        {
          "src": "/icons/icon-192.png",
          "sizes": "192x192"
        }
      ]
    },
    {
      "name": "Client Account Portal",
      "short_name": "Portal",
      "description": "Access order tracking, blueprints and inquiries",
      "url": "/#/portal",
      "icons": [
        {
          "src": "/icons/icon-192.png",
          "sizes": "192x192"
        }
      ]
    }
  ],
  "related_applications": [],
  "prefer_related_applications": false
}
